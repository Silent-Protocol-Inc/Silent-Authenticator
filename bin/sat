#!/usr/bin/env bash

set -euo pipefail

launcher_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
SAT_PROJECT_ROOT="${SAT_PROJECT_ROOT:-$(cd -- "$(dirname -- "$launcher_path")/.." && pwd -P)}"
SAT_ENTRYPOINT="$SAT_PROJECT_ROOT/sat.sh"

if [[ ! -x "$SAT_ENTRYPOINT" ]]; then
	printf 'Error: SAT entrypoint tidak ditemukan atau tidak executable: %s\n' "$SAT_ENTRYPOINT" >&2
	exit 7
fi

exec "$SAT_ENTRYPOINT" "$@"
